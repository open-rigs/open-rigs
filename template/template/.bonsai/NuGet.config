<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      GitHub Packages hosts the OpenRigs.* CI pre-releases that Bonsai.config pins
      (open-rigs/open-rigs CI publishes them on every push).
      GitHub Packages requires authentication even for public packages.

      This file is git-ignored so your credentials stay local. Pick ONE approach:

        a) Set the environment variable before launching Bonsai:
             $env:GITHUB_PACKAGES_TOKEN = "<pat>"
        b) Add credentials to your user-level NuGet config (%AppData%\NuGet\NuGet.config)
           under a packageSourceCredentials entry keyed "github-open-rigs".

      Mint a token: gh auth refresh -s read:packages; gh auth token
      (Use a classic PAT ghp_... — fine-grained PATs are unreliable with GitHub Packages.)
      Your account also needs read access to open-rigs/open-rigs.
    -->
    <add key="github-open-rigs" value="https://nuget.pkg.github.com/open-rigs/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <github-open-rigs>
      <add key="Username" value="open-rigs" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-open-rigs>
  </packageSourceCredentials>
</configuration>
