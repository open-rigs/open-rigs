"""Write config/rig-template.yml, the example rig file that ships with the project, from the rig model.

Runs as the last step of `uv run regenerate`, after the schema and the C# classes. The template holds
placeholder values only. scripts/deploy.ps1 copies it into the machine's folder under ConfigRoot as
rig.yml. A rig's real values are filled in there; per-rig values are never committed.
"""

from pathlib import Path

from open_rigs.core import yaml

from {{ python_folder_name }}.rig import {{ python_class_prefix }}Rig

ROOT = Path(__file__).resolve().parents[1]
TEMPLATE_PATH = ROOT / "config" / "rig-template.yml"
SCHEMA_PATH = "../src/DataSchemas/{{ python_folder_name }}.json#/$defs/{{ python_class_prefix }}Rig"
HEADER = """\
# Rig configuration template, generated by experiment/generate_rig.py. Do not edit by hand.
# scripts/deploy.ps1 copies it to <ConfigRoot>\\<MACHINE-NAME>\\rig.yml when that file does not
# exist yet; fill in the copy there. Per-rig values are never committed.
"""

# Placeholder values only: they must look wrong until a rig fills them in.
rig = {{ python_class_prefix }}Rig(
    root_path="C:\\Data\\CHANGE-ME",
)


def main(path: Path = TEMPLATE_PATH) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    yaml.save(rig, path, schema_path=SCHEMA_PATH)
    directive, body = path.read_text(encoding="utf-8").split("\n", 1)
    path.write_text(directive + "\n" + HEADER + body, encoding="utf-8")
    print(f"Rig configuration template written to {path}")


if __name__ == "__main__":
    main()
