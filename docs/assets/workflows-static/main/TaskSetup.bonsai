<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:p1="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns:p2="clr-namespace:OpenRigsMyRig;assembly=Extensions" xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System" xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Reads the committed task file for this run and publishes the typed task configuration as TaskConfig. Task logic takes its parameters from that subject.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Path" DisplayName="TaskFile" Description="The task file for this run, relative to the workflow. One committed file per protocol under config." />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="io:ReadAllText">
          <io:Path>..\config\task.yml</io:Path>
        </Combinator>
      </Expression>
      <Expression xsi:type="p2:DeserializeFromYaml">
        <p2:Type xsi:type="TypeMapping" TypeArguments="p2:OpenRigsMyRigTaskLogic" />
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>TaskConfig</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>