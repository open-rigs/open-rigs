<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:OpenRigs.Streaming;assembly=OpenRigs.Streaming"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Receives what StreamingSendVideo publishes, all of it from the rig's one socket on 5556. Two subscriptions: the data prefix, split by topic and unpacked to typed values, and the video stream, decoded to frames with the session key and index attached.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Streaming:ReceiveStream.bonsai">
        <RigId>MyRig</RigId>
        <StreamName>data</StreamName>
        <ConnectionString>&gt;tcp://127.0.0.1:5556</ConnectionString>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>ReceivedMessage</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ReceivedMessage</Name>
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>FirstStream</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Topic</Selector>
            </Expression>
            <Expression xsi:type="Equal">
              <Operand xsi:type="StringProperty">
                <Value>MyRig/data/first/</Value>
              </Operand>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="p1:UnpackDataMessage">
        <p1:Type xsi:type="TypeMapping" TypeArguments="sys:Int32" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Value</Selector>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ReceivedMessage</Name>
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>SecondStream</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Topic</Selector>
            </Expression>
            <Expression xsi:type="Equal">
              <Operand xsi:type="StringProperty">
                <Value>MyRig/data/second/</Value>
              </Operand>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="p1:UnpackDataMessage">
        <p1:Type xsi:type="TypeMapping" TypeArguments="sys:Double" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Value</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Streaming:ReceiveStream.bonsai">
        <RigId>MyRig</RigId>
        <StreamName>video</StreamName>
        <ConnectionString>&gt;tcp://127.0.0.1:5556</ConnectionString>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Streaming:UnpackVideoMessage.bonsai">
        <Mode>Unchanged</Mode>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Value</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>SessionKey</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Index</Selector>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="11" To="13" Label="Source1" />
      <Edge From="11" To="14" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
